{
  "train": {
    "epochs": 60,
    "batch_size": 256,
    "learning_rate": 0.003,
    "weight_decay": 0.0001,
    "patience": 12,
    "pos_weight": null,
    "distillation_weight": 0.0,
    "distillation_temperature": 2.0,
    "latent_weight": 0.0,
    "label": "reach_success",
